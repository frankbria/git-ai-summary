# Default AI Provider
# Supported: openai, anthropic, ollama, openrouter, gemini, cohere, mistral, litellm, llm
DEFAULT_AI_PROVIDER=anthropic

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude) Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://github.com/your/repo
OPENROUTER_APP_NAME=git-ai-summary

# Google Gemini Configuration
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1

# Cohere Configuration
COHERE_API_KEY=
COHERE_MODEL=command-r-plus
COHERE_BASE_URL=https://api.cohere.com/v1

# Mistral AI Configuration
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Ollama (Local) Configuration
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# LiteLLM Configuration
# Mode options: python, http, cli
LITELLM_MODE=python
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MODEL=gpt-4o-mini
LITELLM_API_KEY=

# LLM CLI (Simon Willison) Configuration
LLM_MODEL=gpt-4o-mini
LLM_EXTRA_ARGS=

# Global AI Settings
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_LOG_LEVEL=INFO
